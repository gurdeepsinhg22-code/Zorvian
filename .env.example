# API base URL — backend (all /api/* and /uploads/* requests go here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Optional: origin for blog/uploads in local dev (defaults to https://api.medhostech.com in development)
# NEXT_PUBLIC_UPLOADS_ORIGIN=https://api.medhostech.com

# Site URL for SEO (sitemap, canonical URLs, Open Graph) — use production URL in production
NEXT_PUBLIC_SITE_URL=https://medhostech.com

# App branding (optional)
NEXT_PUBLIC_APP_NAME=Medhostech Solutions

# Portal API key - must match backend PORTAL_API_KEY when calling portal APIs
NEXT_PUBLIC_PORTAL_API_KEY=
