# API base URL — medaccess-admin-backend (all /api/* requests go here)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Site URL for SEO (sitemap, canonical URLs, Open Graph) — use production URL in production
NEXT_PUBLIC_SITE_URL=https://medhostech.com

# App branding (optional)
NEXT_PUBLIC_APP_NAME=Medhostech Admin
NEXT_PUBLIC_APP_DESCRIPTION=Admin Portal

# Razorpay Test Mode - must match backend RAZORPAY_KEY_ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Pusher (real-time notifications) - use same key/cluster as backend
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# Portal API key - must match backend PORTAL_API_KEY when calling portal APIs
NEXT_PUBLIC_PORTAL_API_KEY=
